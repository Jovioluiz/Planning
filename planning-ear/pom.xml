<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.planningapp</groupId>
        <artifactId>planning-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>planning-ear</artifactId>
    <packaging>ear</packaging>
    <name>Planning Jakarta :: EAR</name>
    <description>Empacota todos os módulos em um único planning.ear para deploy no WildFly.</description>

    <dependencies>
        <dependency>
            <groupId>com.planningapp</groupId>
            <artifactId>planning-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.planningapp</groupId>
            <artifactId>planning-dto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.planningapp</groupId>
            <artifactId>planning-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.planningapp</groupId>
            <artifactId>planning-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.planningapp</groupId>
            <artifactId>planning-service</artifactId>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>com.planningapp</groupId>
            <artifactId>planning-web</artifactId>
            <type>war</type>
        </dependency>
    </dependencies>

    <build>
        <finalName>planning</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <configuration>
                    <version>11</version>
                    <!-- jars comuns (model, dto, persistence) vão para /lib e ficam visíveis a todos os módulos -->
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <modules>
                        <ejbModule>
                            <groupId>com.planningapp</groupId>
                            <artifactId>planning-service</artifactId>
                            <bundleFileName>planning-service.jar</bundleFileName>
                        </ejbModule>
                        <webModule>
                            <groupId>com.planningapp</groupId>
                            <artifactId>planning-web</artifactId>
                            <bundleFileName>planning-web.war</bundleFileName>
                            <contextRoot>/planning</contextRoot>
                        </webModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
