<?xml version="1.0" encoding="UTF-8"?>
<!--
    configuracoes_redmine.chave_api passa a guardar a chave cifrada (AES-GCM, "v1:" + Base64), maior que a chave
    em texto puro. As chaves já gravadas são cifradas no deploy pela aplicação (CifragemChavesRedmine), que tem o
    segredo; o Liquibase só abre espaço.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-chave-api-redmine-cifrada" author="planning-jakarta">
        <modifyDataType tableName="configuracoes_redmine" columnName="chave_api" newDataType="VARCHAR(512)"/>
    </changeSet>
</databaseChangeLog>
